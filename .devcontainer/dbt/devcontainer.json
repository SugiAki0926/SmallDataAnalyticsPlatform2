{
  "name": "dap2-dbt",
  "dockerComposeFile": "compose.yml",
  "service": "dbt",
  "workspaceFolder": "/workspaces/SmallDataAnalyticsPlatform2",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash .devcontainer/dbt/post-create.sh",
  "remoteEnv": {
    "PATH": "/workspaces/SmallDataAnalyticsPlatform2/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "innoverio.vscode-dbt-power-user",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
